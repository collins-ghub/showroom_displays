# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin gate (single shared password for staff)
ADMIN_PASSWORD=change-me

# Storage bucket name (must match what's created in Supabase)
SUPABASE_STORAGE_BUCKET=showroom-images
